{%- set monthNums = {"January":"01","February":"02","March":"03","April":"04","May":"05","June":"06","July":"07","August":"08","September":"09","October":"10","November":"11","December":"12"} %}
{%- for post in collections.posts %}
{%- set dateParts = post.data.publishDate.split(", ") %}
{%- set monthDay = dateParts[0].split(" ") %}
{%- set day = ("0" + monthDay[1]).slice(-2) %}

  <url>
    <loc>{{ post.data.canonicalUrl }}</loc>
    <lastmod>{{ dateParts[1] }}-{{ monthNums[monthDay[0]] }}-{{ day }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
{%- endfor %}

