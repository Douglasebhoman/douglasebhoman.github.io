  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ title | jsonString | safe }},
    "description": {{ description | jsonString | safe }},
    "datePublished": {{ publishDate | isoDate | jsonString | safe }},
    "url": {{ canonicalUrl | jsonString | safe }},
    "author": {
      "@type": "Person",
      "name": "Douglas Ebhoman",
      "url": "https://douglasebhoman.com"
    },
    "publisher": {
      "@type": "Person",
      "name": "Douglas Ebhoman",
      "url": "https://douglasebhoman.com"
    }
{%- if part %},
    "isPartOf": {
      "@type": "Blog",
      "name": {{ series.name | jsonString | safe }},
      "url": {{ series.url | jsonString | safe }}
    }
{%- endif %}
{%- if citation is string %},
    "citation": {{ citation | jsonString | safe }}
{%- elif citation %},
    "citation": [
{%- for c in citation %}
      {{ c | jsonString | safe }}{% if not loop.last %},{% endif %}
{%- endfor %}
    ]
{%- endif %}
{%- if keywords %},
    "keywords": [{% for k in keywords %}{{ k | jsonString | safe }}{% if not loop.last %}, {% endif %}{% endfor %}]
{%- endif %}
  }
