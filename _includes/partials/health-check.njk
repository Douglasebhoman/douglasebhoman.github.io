{#- Documentation health check widget, shared by the homepage and the audit page.
    Parameter: bookingBlock. When true, the booking block renders after the widget
    and the widget's own "Book the audit" button is left out. -#}
    <div class="hc-widget">
      <div class="hc-steps" id="hcSteps"></div>
      <div id="hcPanel">
        <p class="hc-q-num" id="hcQNum">Question 1 of 6</p>
        <p class="hc-q-text" id="hcQText"></p>
        <div class="hc-options" id="hcOpts"></div>
        <div class="hc-nav">
          <button class="hc-back" id="hcBack" onclick="hcBack()" style="visibility:hidden">&#8592; Back</button>
          <button class="hc-next" id="hcNext" onclick="hcNext()">Next &rarr;</button>
        </div>
      </div>
      <div class="hc-result" id="hcResult">
        <div class="hc-score-wrap">
          <div class="hc-ring">
            <svg width="100" height="100" viewBox="0 0 120 120"><circle cx="60" cy="60" r="50" fill="none" stroke="rgba(184,150,46,0.08)" stroke-width="6"/><circle id="hcCircle" cx="60" cy="60" r="50" fill="none" stroke="#B8962E" stroke-width="6" stroke-linecap="round" stroke-dasharray="314" stroke-dashoffset="314" transform="rotate(-90 60 60)" style="transition:stroke-dashoffset 1s cubic-bezier(0.4,0,0.2,1)"/></svg>
            <div class="hc-ring-num" id="hcNum">0</div>
          </div>
          <div class="hc-score-info">
            <div class="hc-score-tag">Documentation health score</div>
            <div class="hc-score-cat" id="hcCat"></div>
            <p class="hc-score-sub">Based on your answers across accuracy, ownership, and findability.</p>
          </div>
        </div>
        <div class="hc-bars" id="hcBars"></div>
        <div class="hc-insight" id="hcInsight"></div>
        <div class="hc-result-actions">
{% if not bookingBlock %}
          <a href="https://calendly.com/douglas-douglasebhoman/30min" class="btn btn-gold" target="_blank" rel="noopener noreferrer">Book the audit &rarr;</a>
{% endif %}
          <button class="hc-restart" onclick="hcReset()">Start over</button>
        </div>
      </div>
    </div>
{% if bookingBlock %}

    <!-- POST-RESULT CTA: shown automatically after results render -->
    <div class="post-result-cta" id="postResultCta">
      <p class="post-result-cta-heading">Your health check is complete.<br>The audit goes deeper.</p>
      <p class="post-result-cta-body">The health check identifies where your documentation system is breaking. The Documentation Audit identifies exactly why, and delivers a written action plan to fix it &mdash; in five working days.</p>
      <div class="post-result-cta-actions">
        <a href="https://calendly.com/douglas-douglasebhoman/30min" class="btn btn-gold" target="_blank" rel="noopener noreferrer">Book the Audit &rarr;</a>
      </div>
    </div>
{% endif %}
<script>
/* ── HEALTH CHECK ── */
const hcQs = [
  {
    text: "When your team ships a new feature, what happens to the documentation?",
    dim: "accuracy",
    opts: [
      { t: "Docs ship with the feature — there's a definition of done that includes documentation", s: 5, tag: "Disciplined" },
      { t: "We update docs within a sprint or two after shipping", s: 3, tag: "Lagging" },
      { t: "We update when a support ticket or user complaint forces us to", s: 1, tag: "Reactive" },
      { t: "Honestly, the docs are usually just wrong for a while", s: 0, tag: "Broken" }
    ]
  },
  {
    text: "If I picked a random page in your docs right now, who is responsible for keeping it accurate?",
    dim: "ownership",
    opts: [
      { t: "There's a named owner for every page — I can tell you the name in under 30 seconds", s: 5, tag: "Owned" },
      { t: "There's a team responsible, but not a specific person", s: 2, tag: "Diffuse" },
      { t: "Whoever wrote it originally, I suppose", s: 1, tag: "Stale" },
      { t: "Nobody, really. That's part of the problem.", s: 0, tag: "Unowned" }
    ]
  },
  {
    text: "A developer joins your team this week. How do they figure out how your product works?",
    dim: "findability",
    opts: [
      { t: "They read the docs — everything they need is there and easy to navigate", s: 5, tag: "Self-serve" },
      { t: "Docs cover the basics, but they'll need someone to fill in the gaps", s: 3, tag: "Partial" },
      { t: "We'd point them to a few things, but mostly they'd ask a senior engineer", s: 1, tag: "Tribal" },
      { t: "They'd shadow someone for a week. The docs aren't really usable for onboarding.", s: 0, tag: "Absent" }
    ]
  },
  {
    text: "How many support tickets or Slack questions could be answered by your existing documentation?",
    dim: "findability",
    opts: [
      { t: "Most of them — we actively redirect users to docs and it works", s: 5, tag: "Deflecting" },
      { t: "Some of them, but the docs aren't always easy to find or understand", s: 3, tag: "Partial" },
      { t: "A few, but most questions aren't covered or the docs are wrong", s: 1, tag: "Leaking" },
      { t: "Very few. Our support load would barely change if we deleted the docs.", s: 0, tag: "No impact" }
    ]
  },
  {
    text: "When did someone last read your getting-started guide as if they were a new user?",
    dim: "accuracy",
    opts: [
      { t: "Recently — we test it regularly and flag anything that breaks", s: 5, tag: "Maintained" },
      { t: "A few months ago, during a review cycle", s: 3, tag: "Periodic" },
      { t: "When it was written. We assume it still works.", s: 1, tag: "Assumed" },
      { t: "We're not sure it ever got a real user test", s: 0, tag: "Unknown" }
    ]
  },
  {
    text: "If I asked your engineering lead right now: 'Is your documentation healthy?' what would they say?",
    dim: "ownership",
    opts: [
      { t: "Yes — and they could point to a specific process that keeps it that way", s: 5, tag: "Confident" },
      { t: "Probably fine, but they'd be guessing", s: 2, tag: "Uncertain" },
      { t: "It's on the list — we know it needs work but haven't prioritised it", s: 1, tag: "Backlogged" },
      { t: "'Documentation? That's a problem for later.' — We don't really track this.", s: 0, tag: "Ignored" }
    ]
  }
];

const dimContext = {
  accuracy: {
    label: "Accuracy",
    findings: [
      "Your accuracy signals are strong. The audit will verify the systems holding that standard in place are robust enough to survive the team growing.",
      "Some drift is present. The audit will identify which pages are out of sync with the live product and rank them by the support and debugging cost they are generating.",
      "Significant accuracy gaps are present. Developers are already hitting wrong information and losing time to it. The audit will document every failure point and prioritise the fixes.",
      "Your documentation has drifted far enough from the product that it has stopped being a reliable source of truth. The audit will quantify the damage and give you a prioritised remediation plan."
    ],
    fix: "The audit reviews every page against your live product and identifies exactly where the drift is, ranked by how much it's costing you."
  },
  ownership: {
    label: "Ownership",
    findings: [
      "Ownership is in place. The audit will check whether it is enforced through tooling and process, or whether it exists as policy that breaks under growth.",
      "Gaps in ownership mean sections of your documentation have no one responsible for keeping them current. The audit will map every unowned section and recommend a model to close the gaps.",
      "Weak ownership means documentation ages without anyone noticing. The audit will identify every section that has drifted and map it to the process failure that allowed it.",
      "Without ownership, documentation entropy is guaranteed. The audit will make the invisible visible and give you a specific ownership model your team can implement immediately."
    ],
    fix: "The audit maps every section of your documentation to an ownership status and recommends a specific ownership model for your team size."
  },
  findability: {
    label: "Findability",
    findings: [
      "Users are finding answers. The audit will check for subtle structural gaps that may be causing drop-off for less experienced users.",
      "Partial findability means users are hitting dead ends some of the time. The audit will identify the navigation and structure failures that are routing them to your support queue instead.",
      "Low findability means your documentation exists but users cannot navigate to what they need. The audit will identify every structural failure and rank fixes by support ticket impact.",
      "Documentation users cannot find is documentation that does not exist. The audit will rebuild the information architecture case from the ground up and show you exactly what needs to change."
    ],
    fix: "The audit reviews your information architecture and identifies every structural failure that's routing users away from the answer and toward your support queue."
  }
};

const answerFindings = [
  [
    "Your documentation ships with the feature. That's the standard. The audit will verify whether the system holding it together is robust enough to survive the team doubling.",
    "A sprint or two of lag sounds small. Multiplied across twelve months of releases, it means your docs are chronically one sprint behind your product. The audit will identify the pages where drift has already become a liability.",
    "Reactive documentation is documentation that only gets fixed after a user suffers through the wrong version. The audit will identify every page that is currently wrong and prioritise the fixes by support ticket volume.",
    "Documentation that is wrong for a while is documentation that erodes trust. Once a developer stops trusting your docs, they stop reading them — and start asking engineers instead. The audit will tell you exactly how bad the damage is."
  ],
  [
    "Named ownership is the foundation. The audit will check whether that ownership is enforced through your tooling and workflows, or whether it's a policy that exists on paper and breaks in practice.",
    "Team ownership is shared ownership, which is effectively no ownership. The audit will map every section to an individual and recommend the handoff process that makes that ownership stick.",
    "Original-author ownership expires the moment that person moves to a different project. The audit will identify every page whose de facto owner has moved on and left the content stranded.",
    "You've named the problem. The audit will quantify it, rank it by impact, and give you an ownership model you can implement in the same week you receive the report."
  ],
  [
    "Self-serve onboarding is a real competitive advantage. The audit will identify any gaps that are subtle enough to have slipped through your review process.",
    "Partial documentation forces new hires into knowledge extraction from senior engineers — one of the most expensive uses of engineering time. The audit will identify exactly which gaps are driving this.",
    "Tribal knowledge is a single point of failure. Every answer that lives in someone's head and not in your docs is an onboarding problem and a retention risk. The audit will map what's missing.",
    "Docs that don't support onboarding aren't neutral — they're actively costing you. Every new hire who can't self-serve is a week of senior engineer time. The audit will build the case for fixing this."
  ],
  [
    "Active doc deflection is the goal. The audit will check whether your deflection rate could be improved further with structural changes to navigation and search.",
    "Partial deflection means your docs are almost doing their job. The audit will identify which specific structural and content gaps are letting support tickets through that documentation should be catching.",
    "Documentation that can't deflect support is costing you in two places simultaneously: the engineering time to answer tickets and the user frustration of not finding answers. The audit will rank the highest-value fixes.",
    "Documentation with no support impact is documentation that has failed its primary job. The audit will tell you why, specifically, and what would need to change for the docs to start pulling their weight."
  ],
  [
    "Regular testing means you already understand that getting-started guides drift. The audit will check your testing cadence and flag any gaps in coverage.",
    "Periodic review is better than nothing, but quarterly is too slow for a product that ships weekly. The audit will recommend a review cadence matched to your release velocity.",
    "Assuming it works is how broken getting-started guides survive for months without anyone noticing. The audit will test it end-to-end and document every failure point.",
    "An untested getting-started guide is a trust-destroying first impression delivered to every new user. The audit will identify every step that's wrong, outdated, or missing."
  ],
  [
    "Engineering confidence backed by process is the signal that documentation has been systemised. The audit will verify whether the process is robust enough to survive growth.",
    "Guessing about documentation health means there's no system for measuring it. The audit will establish the baseline metrics that make 'is our documentation healthy?' an answerable question.",
    "Backlogged documentation debt compounds every sprint. The audit will quantify the backlog, prioritise it by impact, and give you a plan that can be executed without stopping the roadmap.",
    "Documentation that isn't tracked isn't managed. The audit will make the invisible visible — specific pages, specific failures, specific costs — and give engineering leadership a reason to prioritise it."
  ]
];

let hcAnswers = [], hcCurrent = 0;

function hcRender() {
  const q = hcQs[hcCurrent];
  document.getElementById('hcQNum').textContent = `Question ${hcCurrent + 1} of ${hcQs.length}`;
  document.getElementById('hcQText').textContent = q.text;
  const opts = document.getElementById('hcOpts');
  opts.innerHTML = '';
  q.opts.forEach((o, i) => {
    const btn = document.createElement('button');
    btn.className = 'hc-option' + (hcAnswers[hcCurrent] === i ? ' selected' : '');
    btn.innerHTML = `<span class="hc-opt-text">${o.t}</span><span class="hc-opt-tag">${o.tag}</span>`;
    btn.onclick = () => {
      hcAnswers[hcCurrent] = i;
      document.querySelectorAll('.hc-option').forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      const nextBtn = document.getElementById('hcNext');
      nextBtn.textContent = hcCurrent === hcQs.length - 1 ? 'See my results →' : 'Next →';
      nextBtn.classList.add('on');
    };
    opts.appendChild(btn);
  });

  const steps = document.getElementById('hcSteps');
  steps.innerHTML = hcQs.map((_, i) => {
    const cls = i === hcCurrent ? 'active' : i < hcCurrent ? 'done' : '';
    return `<div class="hc-step ${cls}">${i < hcCurrent ? '✓' : i + 1}</div>${i < hcQs.length - 1 ? '<div class="hc-step-line"></div>' : ''}`;
  }).join('');

  document.getElementById('hcBack').style.visibility = hcCurrent > 0 ? 'visible' : 'hidden';
  const nextBtn = document.getElementById('hcNext');
  nextBtn.textContent = hcCurrent === hcQs.length - 1 ? 'See my results →' : 'Next →';
  nextBtn.classList.toggle('on', hcAnswers[hcCurrent] !== undefined);
}

function hcNext() {
  if (hcAnswers[hcCurrent] === undefined) return;
  if (hcCurrent < hcQs.length - 1) { hcCurrent++; hcRender(); }
  else hcShowResult();
}

function hcBack() {
  if (hcCurrent > 0) { hcCurrent--; hcRender(); }
}

function hcShowResult() {
  const total = hcAnswers.reduce((sum, a, i) => sum + hcQs[i].opts[a].s, 0);
  const max = hcQs.length * 5;
  const pct = Math.round((total / max) * 100);

  document.getElementById('hcPanel').style.display = 'none';
  const result = document.getElementById('hcResult');
  result.classList.add('show');

  setTimeout(() => {
    document.getElementById('hcCircle').style.strokeDashoffset = 314 - (314 * pct / 100);
    document.getElementById('hcNum').textContent = pct + '%';
  }, 100);

  const cat = pct >= 80 ? 'Strong foundation'
            : pct >= 60 ? 'Room to improve'
            : pct >= 40 ? 'At risk'
            : 'Needs urgent attention';
  const catColour = pct >= 80 ? 'var(--green)' : pct >= 60 ? 'var(--gold-light)' : 'var(--gold)';
  document.getElementById('hcCat').textContent = cat;
  document.getElementById('hcCat').style.color = catColour;

  const dims = {};
  hcAnswers.forEach((a, i) => {
    const d = hcQs[i].dim;
    if (!dims[d]) dims[d] = [];
    dims[d].push(hcQs[i].opts[a].s);
  });

  const bars = document.getElementById('hcBars');
  bars.innerHTML = Object.entries(dims).map(([dim, scores]) => {
    const avg = scores.reduce((s, v) => s + v, 0) / scores.length;
    const p = Math.round((avg / 5) * 100);
    const ctx = dimContext[dim];
    const barColour = p >= 80 ? 'var(--green)' : p >= 60 ? 'var(--gold-light)' : p >= 40 ? 'var(--gold)' : '#E05252';
    const findingTier = p >= 80 ? 0 : p >= 60 ? 1 : p >= 40 ? 2 : 3;
    const dimFinding = ctx && ctx.findings ? ctx.findings[findingTier] : '';
    return `<div class="hc-bar-row">
      <div class="hc-bar-row-top">
        <span class="hc-bar-label">${ctx ? ctx.label : dim.charAt(0).toUpperCase() + dim.slice(1)}</span>
        <span class="hc-bar-pct" style="color:${barColour}">${p}%</span>
      </div>
      <div class="hc-bar-track"><div class="hc-bar-fill" style="width:0%;background:${barColour}" data-width="${p}%"></div></div>
      <p class="hc-bar-desc">${dimFinding}</p>
    </div>`;
  }).join('');

  setTimeout(() => {
    bars.querySelectorAll('.hc-bar-fill').forEach(el => { el.style.width = el.dataset.width; });
  }, 200);

  const findings = hcAnswers.map((a, i) => answerFindings[i][a]);

  const dimScores = {};
  hcAnswers.forEach((a, i) => {
    const d = hcQs[i].dim;
    if (!dimScores[d]) dimScores[d] = [];
    dimScores[d].push(hcQs[i].opts[a].s);
  });
  const dimAvgs = Object.entries(dimScores).map(([d, scores]) => ({
    d, avg: scores.reduce((s, v) => s + v, 0) / scores.length
  }));
  dimAvgs.sort((a, b) => a.avg - b.avg);
  const weakest = dimAvgs[0];
  const weakestCtx = dimContext[weakest.d];

  const overallMsg = pct >= 80
    ? `Your documentation system has real foundations. The gaps that remain are the kind that are invisible until a product pivot or a team change exposes them.`
    : pct >= 60
    ? `Your documentation is functional but fragile. It is holding up today, but it is not built to survive the next phase of growth.`
    : pct >= 40
    ? `Your documentation system has structural problems that are already costing you. They will compound as your product grows and your team changes.`
    : `Your documentation system has failed in ways that are actively costing your team every week. The longer this continues, the harder it becomes to fix.`;

  const insightHTML = `
    <div class="hc-insight-label">What this means for you</div>
    <p class="hc-insight-text">${overallMsg}</p>
    <div class="hc-findings">
      ${findings.map((f, i) => `
        <div class="hc-finding">
          <span class="hc-finding-q">Q${i + 1} &mdash; ${hcQs[i].dim.charAt(0).toUpperCase() + hcQs[i].dim.slice(1)}</span>
          <p class="hc-finding-text">${f}</p>
        </div>
      `).join('')}
    </div>
    ${weakestCtx ? `<div class="hc-weakest"><p class="hc-weakest-label">Biggest gap: ${weakestCtx.label}</p><p class="hc-weakest-fix">${weakestCtx.fix}</p></div>` : ''}
  `;
  document.getElementById('hcInsight').innerHTML = insightHTML;

  /* Show post-result CTA */
  const postCta = document.getElementById('postResultCta');
  if (postCta) {
    postCta.style.display = 'block';
    postCta.getBoundingClientRect(); // force reflow so transition fires
    setTimeout(() => { postCta.classList.add('visible'); }, 400);
  }
}

function hcReset() {
  hcAnswers = []; hcCurrent = 0;
  document.getElementById('hcPanel').style.display = 'block';
  document.getElementById('hcResult').classList.remove('show');
  document.getElementById('hcCircle').style.strokeDashoffset = 314;
  const postCta = document.getElementById('postResultCta');
  if (postCta) { postCta.style.display = 'none'; postCta.classList.remove('visible'); }
  hcRender();
}

hcRender();
</script>
